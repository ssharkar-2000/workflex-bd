# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# --- database ---
# On a serverless Postgres (Neon, Supabase) the compute suspends when idle and
# needs a few seconds to wake. Add `&connect_timeout=30` to the URL so a cold
# start does not read as an outage; PrismaService retries on top of that.
DATABASE_URL=postgresql://workflex:workflex_dev_password@localhost:5432/workflex?schema=public

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- auth ---
# Generate real values before deploying anywhere:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_0000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Server-side pepper for hashing OTP codes at rest.
OTP_PEPPER=dev_only_otp_pepper_change_me_00000000000000000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Return the OTP in the API response so the app pre-fills it.
# Convenient, but it hands a valid login code to any caller — leave it false
# and read codes from GET /api/v1/admin/sms/outbox or the API log instead.
# The API refuses to start in production with this enabled.
OTP_EXPOSE_DEV_CODE=false

# --- admin ---
# Admins sign in with email + password (POST /auth/admin/login), never phone.
# Only an email ending in this domain can be an admin account; regular users
# are blocked from claiming it as their optional contact email. Provision an
# account with: npm run admin:create -w @workflex/api -- <email> <password> [name]
ADMIN_EMAIL_DOMAIN=admin.workflex.com.bd
ADMIN_JWT_TTL=8h

# --- sms ---
# Development:
#   file      = append each message to SMS_LOG_FILE as one JSON line.
#               Keeps live codes out of the noisy application log.
#   console   = print to the application log instead.
# Production:
#   bulksmsbd = BulkSMSBD-style HTTP gateway (also fits most BD resellers).
#               Needs SMS_API_KEY + SMS_SENDER_ID.
#   twilio    = no contract required, higher per-message cost.
#
# The API refuses to start with NODE_ENV=production and file/console.
SMS_PROVIDER=file
SMS_LOG_FILE=./logs/sms.log

# For SMS_PROVIDER=bulksmsbd
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ENDPOINT=http://bulksmsbd.net/api/smsapi

# For SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- email (optional channel; phone OTP stays mandatory) ---
# file | console for development.
# smtp for live delivery via Google SMTP (or any SMTP server).
#   Requires a Gmail account with 2-Step Verification on, then an App
#   Password generated at https://myaccount.google.com/apppasswords —
#   the account's normal password will not authenticate here.
# resend for live delivery with your own domain.
MAIL_PROVIDER=file
MAIL_LOG_FILE=./logs/mail.log
MAIL_FROM=WorkFlex BD <no-reply@workflex.com.bd>

# For MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# For MAIL_PROVIDER=resend
RESEND_API_KEY=

# --- storage (minio in dev, S3/R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=workflex
S3_SECRET_KEY=workflex_dev_password
S3_BUCKET_DOCUMENTS=workflex-documents
