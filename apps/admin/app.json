{
  "expo": {
    "name": "WorkFlex BD Admin",
    "slug": "workflex-bd-admin",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "workflexadmin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F4F6F9",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F4F6F9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bd.com.workflex.admin"
    },
    "android": {
      "package": "bd.com.workflex.admin",
      "edgeToEdgeEnabled": true,
      "permissions": ["INTERNET"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-secure-store", "expo-status-bar"]
  }
}
