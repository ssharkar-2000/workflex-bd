// WorkFlex BD — schema v1.
//
// Deliberately only three tables. The walking skeleton proves the pipe
// (device -> HTTP -> auth -> Postgres -> back) before the domain is modelled.
// Profiles, KYC, jobs, attendance and the wallet land in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
  PASSWORD_RESET
}

/// Chosen at registration. A company account additionally proves the business
/// exists; both kinds still prove the person behind it with NID + selfie.
enum AccountType {
  INDIVIDUAL
  COMPANY
}

enum DocumentKind {
  NID_FRONT
  NID_BACK
  SELFIE
  TIN_CERTIFICATE
  TRADE_LICENSE
  /// A one-minute video introduction: the elevator pitch a recruiter can
  /// watch instead of reading. Like the CV it carries no verification weight,
  /// and like the CV there is at most one per account.
  INTRO_VIDEO

  /// A job seeker's CV. Unlike the others this is not identity evidence —
  /// it is the input to skill matching, and carries no verification weight.
  CV
}

/// How confident the match is. Bands rather than a bare number, because "72"
/// invites false precision about something inherently fuzzy.
enum MatchBand {
  STRONG
  GOOD
  FAIR
  WEAK
}

/// Asked at registration of anyone looking for work. Drives which listings
/// are worth surfacing once the jobs module exists; null for recruiters, who
/// are never asked.
enum ExperienceType {
  EXPERIENCED
  FRESHER
}

enum KycStatus {
  NOT_STARTED
  PENDING_REVIEW
  /// A reviewer looked and wants a closer check before deciding.
  ///
  /// Distinct from PENDING_REVIEW, which means nobody has looked yet, and from
  /// REJECTED, which is a decision. Keeping it separate matters to the person
  /// waiting: "still being checked" and "turned down" are not the same news,
  /// and a queue that cannot say so forces reviewers to reject anything they
  /// are unsure about.
  ON_HOLD
  APPROVED
  REJECTED
}

/// Outcome of the automated checks. These assist the human reviewer; they
/// never approve an application on their own.
enum AnalysisStatus {
  QUEUED
  RUNNING
  PASSED
  /// Ran, but the result is weak enough that a person should look closely.
  NEEDS_REVIEW
  FAILED
  /// Could not run — usually a model weight that was never installed.
  SKIPPED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// The id a person can read out: "WF-3A9C1B". Printed on the wallet card,
  /// typed by whoever is paying them, and quoted on every receipt — the uuid
  /// above is for machines and is useless over a phone call.
  publicId String @unique

  /// E.164, always +8801XXXXXXXXX. The primary identity in this product —
  /// most users have no email.
  phone           String    @unique
  phoneVerifiedAt DateTime?

  /// Optional throughout. Phone is the mandatory identity; email is a
  /// convenience channel for notifications and account recovery, and a user
  /// without one is fully functional.
  email           String?   @unique
  emailVerifiedAt DateTime?

  passwordHash String?

  status UserStatus @default(ACTIVE)

  /// 0 = phone verified, 1 = NID verified, 2 = business verified.
  /// Derived from KYC records once that module exists; every gated action
  /// checks this rather than a role.
  verificationLevel Int     @default(0)
  isAdmin           Boolean @default(false)

  /// Preferred UI language. Bangla is the majority case in this market, so it
  /// is stored per account rather than left to device locale.
  locale String @default("bn")

  // --- registration details, filled during onboarding ---
  accountType AccountType?
  firstName   String?
  lastName    String?
  address     String?

  /// Role the person holds at the company they registered. Company accounts
  /// only — an individual answers to nobody.
  designation String?

  /// Job seekers only. Null on a recruiter account.
  experienceType ExperienceType?

  /// Set once the applicant has submitted everything the account type needs.
  onboardingSubmittedAt DateTime?

  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  documents          Document[]
  kycSubmissions     KycSubmission[]
  company            Company?
  supportTickets     SupportTicket[]
  attendance         AttendanceRecord[]
  notificationReads  NotificationRead[]
  savedJobs          SavedJob[]
  applications       JobApplication[]
  cvProfile          CvProfile?
  reports            Report[]
  courses            CourseCompletion[]
  credentials        Credential[]
  mockTests          MockTest[]
  googleConnection   GoogleConnection?

  subscriptions            Subscription[]
  shifts                   Shift[]
  interviewsHeld           Interview[]    @relation("InterviewEmployer")
  interviewsAttended       Interview[]    @relation("InterviewCandidate")
  conversationsAsWorker    Conversation[] @relation("ConversationWorker")
  conversationsAsRecruiter Conversation[] @relation("ConversationRecruiter")
  messagesSent             Message[]
  reviewsWritten           Review[]       @relation("ReviewAuthor")
  reviewsReceived          Review[]       @relation("ReviewSubject")

  wallet           Wallet?
  topUps           TopUp[]
  paymentsMade     WalletPayment[] @relation("PaymentsMade")
  paymentsReceived WalletPayment[] @relation("PaymentsReceived")
  withdrawals      Withdrawal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("users")
}

model OtpCode {
  id String @id @default(uuid()) @db.Uuid

  /// Not a FK — a code is issued before the account exists.
  phone   String
  purpose OtpPurpose @default(LOGIN)

  /// HMAC-SHA256(code, OTP_PEPPER). The plaintext code is never stored,
  /// so a database leak cannot be replayed into account takeover.
  codeHash String

  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone, purpose, consumedAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Company {
  id String @id @default(uuid()) @db.Uuid

  /// The representative who registered it. They must be identity-verified
  /// themselves before the business documents mean anything — otherwise
  /// anyone could upload a photo of someone else's trade licence.
  ownerId String @unique @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name String

  /// RJSC incorporation number. Recorded as claimed — there is no public
  /// registry API to check it against.
  registrationNumber String?

  /// Neither the NBR (TIN) nor the city corporations (trade licence) expose a
  /// verification API, so these are recorded as claimed and confirmed by a
  /// human against the uploaded documents.
  tin            String?
  tradeLicenseNo String?

  verifiedAt DateTime?

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

/// What a language model read out of someone's CV.
///
/// Parsed once on upload and stored, not re-derived per request: extraction
/// costs a model call, and the answer only changes when a new CV is uploaded.
/// Matching against these fields afterwards is arithmetic and runs per query.
model CvProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The Document row this was read from, so a re-upload can supersede it.
  documentId String? @db.Uuid

  /// Lowercased skill names. The matcher intersects these with job text, so
  /// storing them normalised avoids doing it on every comparison.
  skills String[]

  /// Total years of work history the CV evidences. Null when it says nothing
  /// a reader could turn into a number.
  yearsExperience Int?

  /// Job categories the CV suggests, using the product's own taxonomy.
  categories JobCategory[]

  /// Titles the person has actually held, for matching against job titles.
  titles String[]

  /// One or two sentences, shown back so the user can see what was understood
  /// and correct the CV if it is wrong.
  summary String?

  /// Extracted text, kept so a re-parse after a prompt change needs no
  /// re-upload. Never shown to anyone.
  rawText String?

  parsedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cv_profiles")
}

model Document {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind DocumentKind

  /// Path within the private storage root. Never served directly — every read
  /// goes through an authenticated endpoint so access can be logged.
  storageKey   String
  mimeType     String
  sizeBytes    Int
  originalName String?

  analysis DocumentAnalysis?

  createdAt DateTime @default(now())

  /// One current document per kind; re-uploading replaces the previous row.
  @@unique([userId, kind])
  @@index([userId])
  @@map("documents")
}

/// Result of the automated checks for one uploaded document.
model DocumentAnalysis {
  id String @id @default(uuid()) @db.Uuid

  documentId String   @unique @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  status AnalysisStatus @default(QUEUED)

  /// Which analyzers ran, with their individual verdicts and timings.
  checks Json?

  /// Text pulled off the card by Tesseract, and the fields parsed out of it.
  ocrText       String?
  extractedName String?
  extractedNid  String?
  extractedDob  String?

  /// OpenCV image-quality signals, 0..1. Low sharpness or high glare is the
  /// most common reason a reviewer cannot read a card.
  sharpness Float?
  glare     Float?
  cardFound Boolean?

  /// Face signals. `faceMatch` is the descriptor distance between the selfie
  /// and the portrait on the NID — lower is more similar.
  facesDetected Int?
  faceMatch     Float?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("document_analyses")
}

model KycSubmission {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountType AccountType
  status      KycStatus   @default(PENDING_REVIEW)

  reviewedBy   String?   @db.Uuid
  reviewedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("kyc_submissions")
}

model EmailVerification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The address being proven, kept here rather than on User until confirmed,
  /// so an unverified change cannot displace a working address.
  email String

  /// HMAC-SHA256(code, OTP_PEPPER), same treatment as an SMS code.
  codeHash String

  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the opaque token. Never store the token itself.
  tokenHash String @unique

  /// All tokens descended from one login share a family. Presenting an already
  /// rotated token means it leaked, so the whole family is revoked at once.
  familyId String @db.Uuid

  deviceId  String?
  userAgent String?
  ip        String?

  expiresAt DateTime
  revokedAt DateTime?

  /// Set when this token is rotated, for reuse forensics.
  replacedByTokenId String? @db.Uuid

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Deliberately not a row in User. An admin is not a job seeker or hirer who
/// happens to have a flag set — it is a distinct identity, provisioned by
/// script (see scripts/create-admin.mjs), signing in with email + password
/// rather than phone + OTP. The email must end with ADMIN_EMAIL_DOMAIN, which
/// EmailVerificationService also refuses to let any User claim, so the two
/// namespaces can never collide.
model Admin {
  id String @id @default(uuid()) @db.Uuid

  email        String  @unique
  passwordHash String
  name         String?

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  @@map("admins")
}

/// Who a broadcast is aimed at. Kept coarse on purpose — targeting by
/// individual account belongs in a campaign tool, not the admin console.
enum NotificationAudience {
  ALL
  WORKERS
  EMPLOYERS
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  title    String
  body     String
  audience NotificationAudience @default(ALL)

  /// Admin.id. Not a FK: an admin who leaves should not take the record of
  /// what they announced with them.
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())

  /// Set when the broadcast actually goes out. Null means drafted only.
  sentAt DateTime?

  reads NotificationRead[]

  @@index([createdAt])
  @@map("notifications")
}

/// One row per person who has opened a notice.
///
/// Unread is the absence of a row, not a flag on the notice — a notice goes
/// out to a whole audience, so "read" cannot live on the notice itself. It
/// also means a newly created account starts with every past notice unread
/// without anyone having to fan rows out at broadcast time.
model NotificationRead {
  notificationId String @db.Uuid
  userId         String @db.Uuid

  readAt DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id String @id @default(uuid()) @db.Uuid

  /// Nullable so a complaint can arrive before anyone signs in.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  subject  String
  message  String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  /// Free text rather than a thread: one reply closes the vast majority of
  /// these, and a full messaging model can replace it when that stops being true.
  response   String?
  assignedTo String?   @db.Uuid
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("support_tickets")
}

/// Editable copy for the worker app — terms, help text, banner messages.
/// Keyed by a stable slug the app looks up, so changing wording never needs
/// an app release.
model ContentBlock {
  id String @id @default(uuid()) @db.Uuid

  key    String @unique
  title  String
  body   String
  locale String @default("bn")

  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("content_blocks")
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  LATE
}

/// Shift attendance. Deliberately not linked to a Job yet — that table does
/// not exist, and adding a nullable FK now would leave a column nothing can
/// populate. The admin console can already read and filter these records; the
/// worker app gains check-in once the jobs module lands.
model AttendanceRecord {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The shift this attendance is for. Null on records from before shifts
  /// existed, and on any check-in not tied to one.
  shiftId String? @db.Uuid
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  status     AttendanceStatus @default(CHECKED_IN)
  checkInAt  DateTime
  checkOutAt DateTime?

  /// Where the check-in happened, for disputes about whether someone showed up.
  latitude  Float?
  longitude Float?
  note      String?

  createdAt DateTime @default(now())

  @@index([userId, checkInAt])
  @@index([status])
  @@map("attendance_records")
}

// --- jobs ---

/// Mirrors `jobCategorySchema` in @workflex/shared, which is the source of
/// truth for names, emoji and example roles. Kept as an enum here so the
/// database rejects a category the product does not have.
enum JobCategory {
  HOUSEHOLD
  DELIVERY
  HOSPITALITY
  RETAIL
  OFFICE
  IT
  EDUCATION
  TRADES
  BEAUTY
  HEALTHCARE
  CONSTRUCTION
  AGRICULTURE
  EVENTS
  TRANSPORT
  MANUFACTURING
  SECURITY
  PROFESSIONAL
  CREATIVE
  VOLUNTEER
  EMERGENCY
}

enum JobType {
  FULL_TIME
  PART_TIME
  PERMANENT
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
  SEASONAL
  SHIFT_BASED
  ONE_TIME
}

enum PaymentType {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  FIXED_PROJECT
  NEGOTIABLE
}

enum WorkingTime {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
  FLEXIBLE
}

/// Hours per day as bands — postings quote a range, not a figure.
enum HoursBand {
  H2_3
  H4_6
  H6_8
  H8_PLUS
}

enum JobDuration {
  ONE_TIME
  ONE_DAY
  FEW_DAYS
  ONE_WEEK
  ONE_MONTH
  THREE_TO_SIX_MONTHS
  LONG_TERM
}

/// How soon the employer needs someone. Drives the 🔥 badge on urgent cards.
enum Urgency {
  IMMEDIATE
  WITHIN_24H
  WITHIN_3_DAYS
  THIS_WEEK
  NONE
}

/// The country's eight administrative divisions.
enum Division {
  BARISHAL
  CHATTOGRAM
  DHAKA
  KHULNA
  MYMENSINGH
  RAJSHAHI
  RANGPUR
  SYLHET
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY
  ONE_TO_THREE
  THREE_TO_FIVE
  FIVE_PLUS
}

model Job {
  id String @id @default(uuid()) @db.Uuid

  reviews       Review[]
  shifts        Shift[]
  interviews    Interview[]
  conversations Conversation[]

  title        String
  description  String
  /// What the employer asks for, free text. Null on a posting that only has
  /// a description — most informal listings in this market do.
  requirements String?
  /// What the job offers beyond pay: meals, transport, accommodation.
  benefits     String?
  /// How many people are being hired. Null reads as "not specified", which is
  /// honest — plenty of employers genuinely do not say.
  vacancies    Int?

  /// Denormalised rather than joined to Company. Most postings in this market
  /// come from small employers with no registered company record, and a
  /// listing has to render whether or not one exists.
  companyName String
  /// Optional link for the postings that *do* belong to a registered company.
  companyId   String?  @db.Uuid
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// Who posted it. Null on seeded and imported listings.
  postedBy String? @db.Uuid

  category        JobCategory
  jobType         JobType         @default(FULL_TIME)
  workplaceType   WorkplaceType   @default(ONSITE)
  experienceLevel ExperienceLevel @default(ENTRY)

  /// As the recruiter typed it — "Mirpur 10, Dhaka". Searched free-text.
  location String
  /// Structured location, for the division/district filters. Nullable because
  /// an imported or hastily-written posting may only have the free text.
  division Division?
  district String?

  paymentType PaymentType @default(MONTHLY)
  /// Numeric so the range filter can compare. Null means unstated, which is
  /// common — "negotiable" postings carry neither bound.
  salaryMin   Int?
  salaryMax   Int?
  /// Optional human-written override for the card, e.g. "৳500/day + lunch".
  /// Falls back to a label formatted from the bounds above.
  salaryRange String?

  workingTime WorkingTime @default(FLEXIBLE)
  hoursBand   HoursBand?
  duration    JobDuration @default(LONG_TERM)
  urgency     Urgency     @default(NONE)

  /// Where the work is, as a point.
  ///
  /// Resolved from `location` against the gazetteer in @workflex/shared, so
  /// it is the centre of the named place rather than a surveyed address —
  /// accurate to the size of that place, which is what the app tells the
  /// reader. Nullable because a posting can name somewhere the table does
  /// not know, and a wrong point is worse than no point.
  latitude  Float?
  longitude Float?

  /// When the work begins. Null with flexibleStart means "whenever suits".
  startDate     DateTime?
  flexibleStart Boolean   @default(true)

  /// Null means the posting stays open until it is closed by hand.
  deadline DateTime?
  /// Hidden from the seeker feed without deleting the record.
  isOpen   Boolean   @default(true)

  savedBy      SavedJob[]
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isOpen, createdAt])
  @@index([category])
  @@index([jobType])
  @@index([urgency])
  @@index([duration])
  @@index([division, district])
  @@map("jobs")
}

/// A seeker's bookmark. Same shape as NotificationRead — the absence of a row
/// is "not saved", so nothing has to be written when a job is merely seen.
model SavedJob {
  jobId  String @db.Uuid
  userId String @db.Uuid

  savedAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jobId, userId])
  @@index([userId, savedAt])
  @@map("saved_jobs")
}

/// Where an application has got to.
///
/// Ordered as the applicant experiences it. WITHDRAWN is kept as a status
/// rather than deleting the row: a recruiter who has already read someone's
/// application should see that it was pulled, not watch it vanish.
enum ApplicationStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Someone applying to a posting.
///
/// Keyed like SavedJob — one row per person per job, so applying twice is
/// impossible at the database level rather than by a check that can race.
/// Re-applying after withdrawing reuses the row.
model JobApplication {
  jobId  String @db.Uuid
  userId String @db.Uuid

  status  ApplicationStatus @default(SUBMITTED)
  /// Optional note to the employer. Most people send nothing, which is fine —
  /// the CV and profile carry the substance.
  message String?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the recruiter confirmed the hired person's work is finished. Null
  /// while it is still going on. The status stays ACCEPTED, so payments,
  /// reviews and trust keep counting the hire; it only leaves the
  /// recruiter's hired list.
  completedAt DateTime?

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jobId, userId])
  @@index([userId, appliedAt])
  @@index([jobId, status])
  @@map("job_applications")
}

// --- reports ---

/// What the reporter says went wrong. Ordered so the queue can be triaged:
/// fraud and non-payment need acting on today, a technical complaint does not.
enum ReportCategory {
  FRAUD
  FAKE_JOB
  MISLEADING_PAY
  NON_PAYMENT
  HARASSMENT
  UNSAFE_WORK
  FAKE_PROFILE
  TECHNICAL
  OTHER
}

enum ReportTarget {
  SYSTEM
  JOB
  PERSON
  OTHER
}

/// ACTION_TAKEN and DISMISSED are both endings, kept apart because they mean
/// opposite things to the reporter and to anyone auditing the queue later.
enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTION_TAKEN
  DISMISSED
}

/// A complaint about the platform, a posting, or another person.
///
/// Separate from SupportTicket: that is "I need help" and ends when someone
/// answers, while this may end in a suspended account or a removed posting,
/// and the reporter is not always entitled to know which.
model Report {
  id String @id @default(uuid()) @db.Uuid

  /// Nullable so a report survives the reporter deleting their account —
  /// the complaint may still need acting on.
  reporterId String? @db.Uuid
  reporter   User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  category   ReportCategory
  targetType ReportTarget   @default(OTHER)

  /// Set when the report is about a posting. Not a FK to Job: a scam listing
  /// gets deleted, and the report about it must outlive the deletion.
  targetJobId String? @db.Uuid
  /// The reported person as the reporter knows them — a phone number from a
  /// job advert, not an account id they have no way of seeing.
  targetPhone String?

  subject String
  details String

  status   ReportStatus @default(OPEN)
  response String?

  reviewedBy String?   @db.Uuid
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category])
  @@index([reporterId])
  @@map("reports")
}

// --- wallet ---
//
// Amounts are whole taka throughout, as integers — see @workflex/shared's
// wallet.ts for why.
//
// No relation here deletes on cascade. Accounts are closed by status, never
// removed, and a ledger that could vanish along with a user would not be a
// ledger. The database refuses to delete a user who has money history.

/// One per account, created the first time money moves.
model Wallet {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Everything in the wallet.
  balance      Int @default(0)
  /// The part of `balance` that was earned — paid in by someone who hired this
  /// account — and so may be withdrawn. Always between 0 and `balance`.
  ///
  /// Money added through the gateway is spendable but not withdrawable. If it
  /// were, the wallet would be a way to turn a stolen card into bKash cash:
  /// top up with the card, withdraw to a mobile wallet, gone. Earnings are
  /// money another verified account chose to pay for work.
  withdrawable Int @default(0)

  entries WalletEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

enum WalletEntryType {
  TOP_UP
  PAYMENT_SENT
  PAYMENT_RECEIVED
  WITHDRAWAL
  /// A withdrawal that was turned down or cancelled, back in the wallet.
  WITHDRAWAL_RETURNED
}

/// The ledger.
///
/// Append-only: a mistake is corrected by a new entry, never by editing an old
/// one. Each row records the balance straight after it, so a statement reads
/// without re-adding history, and a broken ledger shows up as a row whose
/// balanceAfter minus amount is not the previous row's balanceAfter.
model WalletEntry {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type         WalletEntryType
  /// Signed: positive into the wallet, negative out of it.
  amount       Int
  balanceAfter Int

  /// What caused the entry. Exactly one is set.
  topUpId      String?        @db.Uuid
  topUp        TopUp?         @relation(fields: [topUpId], references: [id], onDelete: Restrict)
  paymentId    String?        @db.Uuid
  payment      WalletPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  withdrawalId String?        @db.Uuid
  withdrawal   Withdrawal?    @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_entries")
}

enum TopUpStatus {
  /// Sent to the gateway; no answer yet.
  PENDING
  /// Confirmed with the gateway and credited.
  PAID
  FAILED
  CANCELLED
  /// The gateway took the money but flagged it as risky, or its figures did
  /// not match ours. Nothing is credited until a person approves it.
  HELD
  /// A held payment that was turned down. It is refunded through the
  /// gateway's merchant panel — the wallet never saw it.
  REJECTED
}

/// Money added through the payment gateway.
model TopUp {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  amount Int
  status TopUpStatus @default(PENDING)

  /// How the money arrived. "manual" for a deposit the person made from
  /// their own bKash, Nagad or bank app and then declared here.
  gateway String
  /// Our reference, sent to the gateway as `tran_id`.
  tranId  String @unique

  /// Only a redirecting gateway needs somewhere to send the person back to,
  /// so this is null for a declared deposit.
  returnUrl String?

  // --- a deposit the person made themselves, and says they made ---

  /// Which service it was sent from.
  depositMethod PayoutMethod?
  /// The account it came from — their bKash or Nagad number, or a bank
  /// account. Whoever approves it checks this against the receiving
  /// statement.
  senderAccount String?
  /// The transaction id their own app gave them. Unique per method, so one
  /// receipt cannot be claimed twice.
  reference     String?

  // --- from the gateway's validation, never from the callback itself ---
  valId      String?
  bankTranId String?
  /// How it was paid, as the gateway names it: "BKASH-BKash".
  method     String?
  /// The gateway's fraud signal: 1 means it asked for the payment to be checked.
  riskLevel  Int?
  riskTitle  String?

  /// Admin.id of whoever decided a HELD payment. Not a FK, as on KycSubmission.
  reviewedBy String?   @db.Uuid
  reviewedAt DateTime?
  reviewNote String?

  entries WalletEntry[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([depositMethod, reference])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("wallet_top_ups")
}

/// A recruiter paying someone they hired.
model WalletPayment {
  id String @id @default(uuid()) @db.Uuid

  payerId String @db.Uuid
  payer   User   @relation("PaymentsMade", fields: [payerId], references: [id], onDelete: Restrict)
  payeeId String @db.Uuid
  payee   User   @relation("PaymentsReceived", fields: [payeeId], references: [id], onDelete: Restrict)

  /// The posting the work was for. Not a FK, for the reason Report gives: a
  /// posting can be deleted, and the record of a payment must outlive it. The
  /// title is copied for the same reason.
  /// Null when this is a person-to-person transfer rather than pay for a
  /// job — the wallet's own send-money, including by QR.
  jobId    String? @db.Uuid
  jobTitle String?

  amount Int
  note   String?

  /// The app's key for this confirmation. A repeat is the same payment.
  requestId String @unique @db.Uuid

  entries WalletEntry[]

  createdAt DateTime @default(now())

  @@index([payerId, createdAt])
  @@index([payeeId, createdAt])
  @@index([jobId, payeeId])
  @@map("wallet_payments")
}

enum PayoutMethod {
  BKASH
  NAGAD
  BANK
}

enum WithdrawalStatus {
  /// Asked for; the money has left the wallet and waits to be sent.
  PENDING
  /// Sent. `payoutReference` is the transfer's transaction ID.
  PAID
  /// Turned down; the money went back into the wallet.
  REJECTED
  /// Called off by the person before it was sent; the money went back.
  CANCELLED
}

/// Earnings going out to bKash, Nagad or a bank account.
///
/// Sent by a person from the admin console, not by an API. The payment
/// gateway collects money and has no call for paying it out, and a payout
/// API (bKash's disbursement service, say) needs its own merchant agreement.
/// When one exists it slots in where an admin marks the request paid today.
model Withdrawal {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  amount Int
  method PayoutMethod

  /// The bKash or Nagad number (+8801XXXXXXXXX), or the bank account number.
  accountNumber String
  accountName   String
  bankName      String?
  branchName    String?
  routingNumber String?

  status WithdrawalStatus @default(PENDING)

  /// The app's key for this request. A repeat is the same withdrawal.
  requestId String @unique @db.Uuid

  payoutReference String?
  rejectReason    String?
  /// Admin.id of whoever sent or refused it. Not a FK, as on KycSubmission.
  processedBy     String?   @db.Uuid
  processedAt     DateTime?

  entries WalletEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("wallet_withdrawals")
}

/// What someone gets for paying, and until when.
///
/// One row per purchase rather than one per account: a renewal is a new row,
/// so the history of what was paid and when stays readable, and an expiry is
/// a date that passed rather than a row that was overwritten.
model Subscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus @default(ACTIVE)

  /// What was actually charged, in paisa — kept on the row because a plan's
  /// price may change and an old subscription should still say what it cost.
  price Int

  startedAt DateTime  @default(now())
  /// Null for a lifetime plan, which does not end.
  expiresAt DateTime?

  cancelledAt DateTime?

  /// The wallet payment that bought it, so the two can be reconciled.
  paymentId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([status, expiresAt])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// One person's verdict on another, for one job.
///
/// Both directions are the same table: the same account is rated as a worker
/// on jobs it was hired for and as a recruiter on jobs it posted, and
/// `subjectRole` says which of the two this row is about. Keeping them apart
/// would mean two tables that are identical except for a word.
///
/// Tied to a job, and unique per author per person per job, so a review is
/// evidence of work that happened rather than an opinion anyone can repeat.
model Review {
  id String @id @default(uuid()) @db.Uuid

  jobId String @db.Uuid
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  subjectId String @db.Uuid
  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  /// Which side the subject was on for this job.
  subjectRole ReviewRole

  /// One to five. Halves are not offered: people do not agree on what 3.5
  /// means, and the average carries the nuance.
  rating  Int
  comment String?

  /// The two questions worth asking beyond a number, both optional because
  /// a rating with no answers is still a rating.
  onTime         Boolean?
  wouldWorkAgain Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One review of each person per job. Per person rather than per role: a
  /// recruiter who hired three people for one job reviews all three.
  @@unique([jobId, authorId, subjectId])
  @@index([subjectId, subjectRole, createdAt])
  @@map("reviews")
}

enum ReviewRole {
  WORKER
  RECRUITER
}

/// A piece of work with a start and an end: one person, one job, one span of
/// time.
///
/// A job is the posting — "cleaner needed, Dhanmondi" — and may be worked by
/// several people on several days. A shift is one of those occasions, which
/// is what somebody actually turns up to, checks into, and is paid for.
///
/// Created by whoever posted the job, for someone already hired onto it.
model Shift {
  id String @id @default(uuid()) @db.Uuid

  jobId String @db.Uuid
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Who is working it.
  workerId String @db.Uuid
  worker   User   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  status ShiftStatus @default(CONFIRMED)

  startsAt DateTime
  endsAt   DateTime

  /// Where to turn up, when that differs from the job's own location.
  location  String?
  latitude  Float?
  longitude Float?

  /// What the shift pays, in paisa. Held here rather than read from the job
  /// because a Friday night rate is not a Tuesday morning rate.
  pay Int

  // --- what the person needs to know before turning up ---
  instructions       String?
  contactName        String?
  contactPhone       String?
  dressCode          String?
  /// "NID", "Trade licence" — what to bring.
  requiredDocuments  String[]
  cancellationPolicy String?

  attendanceMethod AttendanceMethod @default(MANUAL)

  // --- what it came to, filled in once it is over ---
  basePay     Int?
  overtimePay Int?
  bonusPay    Int?

  cancelledAt  DateTime?
  cancelReason String?

  attendance AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId, startsAt])
  @@index([jobId, startsAt])
  @@index([status, startsAt])
  @@map("shifts")
}

enum ShiftStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// How someone proves they were there.
enum AttendanceMethod {
  /// Tap a button. Trusted because both sides can see the time it recorded.
  MANUAL
  /// Scan the employer's code at the site.
  QR
  /// Check in with coordinates, matched against the shift's own.
  GPS
}

/// One thread between the two sides of one job.
///
/// Messaging here is not a social feature: a conversation exists because
/// somebody applied to a job or was hired for it, and it is always about
/// that job. That is what keeps the inbox free of strangers, and it is why
/// the pair (job, worker) is unique — the same two people discussing two
/// different jobs get two threads, which is what they would want.
///
/// Which section of the inbox a thread appears in is worked out when it is
/// read, not stored: the same row is "an application" to the worker and
/// "hiring" to the recruiter, and becomes "work" for both once a shift
/// exists.
model Conversation {
  id String @id @default(uuid()) @db.Uuid

  jobId String @db.Uuid
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// The person who applied or was hired.
  workerId String @db.Uuid
  worker   User   @relation("ConversationWorker", fields: [workerId], references: [id], onDelete: Cascade)

  /// The person who posted the job.
  recruiterId String @db.Uuid
  recruiter   User   @relation("ConversationRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)

  messages Message[]

  /// When each side last opened the thread. Unread counts are messages
  /// after that moment written by the other person — one timestamp per
  /// side rather than a read flag per message, which would be a row per
  /// message per reader for no extra truth.
  workerReadAt    DateTime?
  recruiterReadAt DateTime?

  /// Muted threads stay in the inbox but stop notifying.
  workerMuted    Boolean @default(false)
  recruiterMuted Boolean @default(false)

  /// A blocked thread takes no new messages from either side. Who did it is
  /// kept so the other person can be told it was not a fault of theirs.
  blockedAt DateTime?
  blockedBy String?   @db.Uuid

  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, workerId])
  @@index([workerId, lastMessageAt])
  @@index([recruiterId, lastMessageAt])
  @@map("conversations")
}

/// One message. Most are text; the rest carry something the app renders as a
/// card — a location, a shift, an interview invitation — with its details in
/// `payload` rather than typed out in a sentence nobody can act on.
model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  kind MessageKind @default(TEXT)
  body String?

  /// Where an attachment lives in object storage, and what it is.
  attachmentKey  String?
  attachmentName String?
  attachmentType String?

  /// The card's own fields: coordinates, a shift id, interview times.
  payload Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageKind {
  TEXT
  IMAGE
  FILE
  LOCATION
  /// A shift, rendered as a card the other side can open.
  SHIFT
  /// An invitation with a time on it, which can be accepted or declined.
  INTERVIEW
  /// Written by the platform rather than a person: "Shift confirmed."
  SYSTEM
}

/// A meeting between the two sides of a job, before any work happens.
///
/// Held online through this system or in person at an address, which is the
/// same arrangement either way: a time, a length, and two people who have
/// both been told. Only somebody who applied can be invited to one — an
/// interview is a step in an application, not a way to summon a stranger.
///
/// The candidate answers it. Until they do it is SCHEDULED and nobody should
/// assume they are coming; a declined interview keeps its row so both sides
/// can see what was proposed and what happened to it.
model Interview {
  id String @id @default(uuid()) @db.Uuid

  jobId String @db.Uuid
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Whoever posted the job — a person hiring for themselves, or somebody
  /// representing a company.
  employerId String @db.Uuid
  employer   User   @relation("InterviewEmployer", fields: [employerId], references: [id], onDelete: Cascade)

  candidateId String @db.Uuid
  candidate   User   @relation("InterviewCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  mode   InterviewMode
  status InterviewStatus @default(SCHEDULED)

  scheduledAt     DateTime
  durationMinutes Int      @default(30)

  /// Where to go, for a meeting in person.
  location String?

  /// Where to join, for one held online. Generated by this system unless the
  /// employer supplies their own link.
  meetingUrl String?

  /// The Google Calendar event behind a Meet link, so moving or cancelling
  /// the interview moves or cancels the event too. Null for Jitsi rooms.
  googleEventId String?

  /// Who the candidate should ask for, and anything they should bring or
  /// prepare.
  interviewerName String?
  notes           String?

  /// When the candidate accepted or declined, and what they said.
  respondedAt   DateTime?
  declineReason String?

  /// What came of it, written afterwards by the employer.
  outcome String?

  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId, scheduledAt])
  @@index([employerId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("interviews")
}

enum InterviewMode {
  /// Held in this app, over a link.
  VIDEO
  /// A phone call at an agreed time.
  PHONE
  /// At an address — what a company representative usually wants.
  IN_PERSON
}

enum InterviewStatus {
  /// Proposed, and waiting on the candidate.
  SCHEDULED
  /// The candidate said yes.
  ACCEPTED
  /// The candidate said no.
  DECLINED
  /// Moved to another time; the row keeps its history.
  RESCHEDULED
  COMPLETED
  CANCELLED
  /// The time passed with nobody there.
  NO_SHOW
}

/// ---------------------------------------------------------------------------
/// Learning lab
/// ---------------------------------------------------------------------------

/// A free course this platform suggested, that the person says they finished.
///
/// Suggestions themselves are not stored: they are generated from the CV and
/// from live demand every time the screen opens, so a saved list would go
/// stale against the postings it was derived from. What is worth keeping is
/// the other half — what somebody actually went and did about a gap.
///
/// Nothing here is verified by this platform. `declaredAt` is the person's own
/// word, and the certificate is a file they uploaded; neither is checked
/// against the course provider, and the screens say so. A claim with a
/// certificate attached is still only a claim, but it is one an employer can
/// look at.
model CourseCompletion {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The course as it was suggested, kept as text rather than a foreign key:
  /// the suggestion it came from does not outlive the screen that made it.
  title    String
  provider String
  /// Where it was found. A search, not a deep link — see courses.service.ts.
  url      String?
  /// The gap it was suggested for, so this can be read back against the CV.
  skill    String

  /// When the person said they had finished it.
  declaredAt DateTime @default(now())

  /// The certificate, when there is one. Optional by design: plenty of free
  /// courses issue nothing at the end, and refusing the claim without paper
  /// would record less of what people have actually done.
  storageKey   String?
  mimeType     String?
  sizeBytes    Int?
  originalName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, declaredAt])
  @@map("course_completions")
}

// --- verifiable credentials ---

/// Who is allowed to attest to somebody's past.
///
/// A university, a training centre, or a company somebody used to work for.
/// Each holds an ed25519 key pair; the public half lives here and the
/// private half never touches this database — it stays with the institution,
/// which is the entire point. WorkFlex BD cannot forge a credential it did
/// not issue, and cannot be made to.
///
/// `approvedAt` is this platform vouching that the key really belongs to the
/// named institution. A signature proves a key signed something; only a
/// registry can say whose key it is, and that step is human.
model Issuer {
  id String @id @default(uuid()) @db.Uuid

  name String
  kind IssuerKind

  /// A decentralised identifier, `did:key:z...`, derived from the public key.
  /// Portable: a credential carries it, so anyone holding the credential can
  /// check the signature without asking this server anything.
  did String @unique

  /// The verifying half, base64url. Never the signing half.
  publicKey String

  /// Where a sceptic can check this issuer exists. A website, not a promise.
  website String?
  contact String?

  /// Null until an administrator has confirmed the key belongs to the name.
  approvedAt DateTime?
  approvedBy String?   @db.Uuid

  credentials Credential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, approvedAt])
  @@map("issuers")
}

enum IssuerKind {
  UNIVERSITY
  COLLEGE
  TRAINING_CENTRE
  EMPLOYER
  GOVERNMENT
}

/// One signed statement about one person, and its place in the ledger.
///
/// Two independent things make this verifiable, and both are checked
/// separately so a reader can see which one failed:
///
///   1. The signature. The issuer signed the canonical payload with a key
///      this platform never held, so altering any field breaks it.
///   2. The chain. Every credential records the hash of the one before it,
///      so the record is append-only: changing an old row changes its hash
///      and orphans everything issued after it.
///
/// The second is what a blockchain is for, built here as a local hash chain.
/// See credentials.service.ts for what that does and does not give you, and
/// what anchoring it to a public chain would add.
model Credential {
  id String @id @default(uuid()) @db.Uuid

  /// Whose credential it is.
  subjectId String @db.Uuid
  subject   User   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  issuerId String @db.Uuid
  issuer   Issuer @relation(fields: [issuerId], references: [id], onDelete: Restrict)

  kind CredentialKind

  /// "BSc in Computer Science", "Senior Electrician", "Food Safety Level 2".
  title String
  /// The subject, trade or department, where one applies.
  field String?
  /// A class, grade or CGPA, exactly as the institution words it.
  grade String?

  startDate DateTime?
  endDate   DateTime?

  /// Anything else the issuer chose to attest, signed along with the rest.
  claims Json?

  // --- the ledger ---

  /// Position in the append-only chain, from zero.
  index Int @unique

  /// SHA-256 of the credential contents alone, hex. This is what the issuer
  /// signs: it can be computed by the institution before the credential is
  /// sent, without knowing where in the ledger it will land.
  contentHash String

  /// SHA-256 of the content hash together with its ledger position, hex.
  /// This is what the chain links. Separating the two is what lets the
  /// issuer sign offline and the ledger stay append-only.
  hash String @unique

  /// The hash of credential `index - 1`. All zeroes for the first.
  prevHash String

  /// ed25519 over `contentHash`, base64url. Made with the issuer's private
  /// key, which this server has never held.
  signature String

  issuedAt DateTime @default(now())

  /// Set when the issuer withdraws it — a degree rescinded, a letter issued
  /// in error. The row is never deleted: a credential that vanishes cannot
  /// be told apart from one that never existed, and the chain would break.
  revokedAt    DateTime?
  revokeReason String?

  createdAt DateTime @default(now())

  @@index([subjectId, issuedAt])
  @@index([issuerId, issuedAt])
  @@map("credentials")
}

enum CredentialKind {
  DEGREE
  DIPLOMA
  CERTIFICATE
  TRAINING
  EXPERIENCE_LETTER
  LICENCE
}

// --- mock tests ---

/// One practice test: its questions, the attempt at it, and what it came to.
///
/// Test and attempt are one row rather than two. A mock test is generated
/// fresh for the person taking it — that is what makes it practice rather
/// than an exam — so a test with no attempt is not a thing that exists, and
/// splitting them would mean a join that never has anything useful on the
/// other side.
///
/// The questions are stored as written, answers and all. They have to be:
/// scoring happens here, and a question whose correct answer lived only in
/// the model's reply could never be marked twice the same way. What the app
/// sends to the phone has the answers stripped — see MockTestsService.
model MockTest {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category JobCategory
  level    MockLevel   @default(INTERMEDIATE)
  /// "Frontend Development", "Customer Service" — what the person chose.
  title    String

  /// [{ prompt, code?, options: string[4], answer: 0-3, skill, why }]
  questions Json
  /// What they picked, by index, nulls for unanswered. Written on submit.
  answers   Json?

  durationSeconds Int @default(900)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  /// Correct answers out of `total`. Null until submitted.
  score  Int?
  total  Int
  passed Boolean?

  /// Per-skill percentages, for the breakdown bars.
  /// [{ skill, correct, asked }]
  breakdown Json?

  /// Whether a model wrote the questions or they came from the bank.
  source String @default("assembled")

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, category])
  @@map("mock_tests")
}

/// How hard the questions are pitched.
enum MockLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// --- google meet ---

/// A recruiter's link to their own Google account, for creating Meet rooms.
///
/// Only the refresh token is kept, and only encrypted — see GoogleService.
/// Access tokens last an hour and are fetched fresh when needed rather than
/// stored, because a stored access token is a credential sitting in a table
/// for no benefit.
model GoogleConnection {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The Google account it belongs to, shown so the person knows which one.
  googleEmail String

  /// AES-256-GCM, "iv.tag.ciphertext" in base64url. Never logged.
  refreshToken String

  scope String

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("google_connections")
}
