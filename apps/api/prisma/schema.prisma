// WorkFlex BD — schema v1.
//
// Deliberately only three tables. The walking skeleton proves the pipe
// (device -> HTTP -> auth -> Postgres -> back) before the domain is modelled.
// Profiles, KYC, jobs, attendance and the wallet land in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
  PASSWORD_RESET
}

/// Chosen at registration. A company account additionally proves the business
/// exists; both kinds still prove the person behind it with NID + selfie.
enum AccountType {
  INDIVIDUAL
  COMPANY
}

enum DocumentKind {
  NID_FRONT
  NID_BACK
  SELFIE
  TIN_CERTIFICATE
  TRADE_LICENSE
  /// A job seeker's CV. Unlike the others this is not identity evidence —
  /// it is the input to skill matching, and carries no verification weight.
  CV
}

/// How confident the match is. Bands rather than a bare number, because "72"
/// invites false precision about something inherently fuzzy.
enum MatchBand {
  STRONG
  GOOD
  FAIR
  WEAK
}

/// Asked at registration of anyone looking for work. Drives which listings
/// are worth surfacing once the jobs module exists; null for recruiters, who
/// are never asked.
enum ExperienceType {
  EXPERIENCED
  FRESHER
}

enum KycStatus {
  NOT_STARTED
  PENDING_REVIEW
  /// A reviewer looked and wants a closer check before deciding.
  ///
  /// Distinct from PENDING_REVIEW, which means nobody has looked yet, and from
  /// REJECTED, which is a decision. Keeping it separate matters to the person
  /// waiting: "still being checked" and "turned down" are not the same news,
  /// and a queue that cannot say so forces reviewers to reject anything they
  /// are unsure about.
  ON_HOLD
  APPROVED
  REJECTED
}

/// Outcome of the automated checks. These assist the human reviewer; they
/// never approve an application on their own.
enum AnalysisStatus {
  QUEUED
  RUNNING
  PASSED
  /// Ran, but the result is weak enough that a person should look closely.
  NEEDS_REVIEW
  FAILED
  /// Could not run — usually a model weight that was never installed.
  SKIPPED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// The id a person can read out: "WF-3A9C1B". Printed on the wallet card,
  /// typed by whoever is paying them, and quoted on every receipt — the uuid
  /// above is for machines and is useless over a phone call.
  publicId String @unique

  /// E.164, always +8801XXXXXXXXX. The primary identity in this product —
  /// most users have no email.
  phone           String    @unique
  phoneVerifiedAt DateTime?

  /// Optional throughout. Phone is the mandatory identity; email is a
  /// convenience channel for notifications and account recovery, and a user
  /// without one is fully functional.
  email           String?   @unique
  emailVerifiedAt DateTime?

  passwordHash String?

  status UserStatus @default(ACTIVE)

  /// 0 = phone verified, 1 = NID verified, 2 = business verified.
  /// Derived from KYC records once that module exists; every gated action
  /// checks this rather than a role.
  verificationLevel Int     @default(0)
  isAdmin           Boolean @default(false)

  /// Preferred UI language. Bangla is the majority case in this market, so it
  /// is stored per account rather than left to device locale.
  locale String @default("bn")

  // --- registration details, filled during onboarding ---
  accountType AccountType?
  firstName   String?
  lastName    String?
  address     String?

  /// Role the person holds at the company they registered. Company accounts
  /// only — an individual answers to nobody.
  designation String?

  /// Job seekers only. Null on a recruiter account.
  experienceType ExperienceType?

  /// Set once the applicant has submitted everything the account type needs.
  onboardingSubmittedAt DateTime?

  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  documents          Document[]
  kycSubmissions     KycSubmission[]
  company            Company?
  supportTickets     SupportTicket[]
  attendance         AttendanceRecord[]
  notificationReads  NotificationRead[]
  savedJobs          SavedJob[]
  applications       JobApplication[]
  cvProfile          CvProfile?
  reports            Report[]

  subscriptions    Subscription[]
  shifts           Shift[]
  interviewsHeld     Interview[] @relation("InterviewEmployer")
  interviewsAttended Interview[] @relation("InterviewCandidate")
  conversationsAsWorker    Conversation[] @relation("ConversationWorker")
  conversationsAsRecruiter Conversation[] @relation("ConversationRecruiter")
  messagesSent             Message[]
  reviewsWritten   Review[]       @relation("ReviewAuthor")
  reviewsReceived  Review[]       @relation("ReviewSubject")

  wallet           Wallet?
  topUps           TopUp[]
  paymentsMade     WalletPayment[] @relation("PaymentsMade")
  paymentsReceived Wallet
