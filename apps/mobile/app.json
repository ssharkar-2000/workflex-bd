{
  "expo": {
    "name": "WorkFlex BD",
    "slug": "workflex-bd",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "workflex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FBF4EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bd.com.workflex.app"
    },
    "android": {
      "package": "bd.com.workflex.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "WorkFlex BD needs access to your photos so you can upload your NID and business documents.",
          "cameraPermission": "WorkFlex BD needs the camera to photograph your NID and complete face verification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1"
    }
  }
}
