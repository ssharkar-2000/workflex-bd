    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bd.workflex.admin"
    },
    "android": {
      "package": "bd.workflex.admin"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
